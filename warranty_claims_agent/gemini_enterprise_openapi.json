{
  "openapi": "3.0.3",
  "info": {
    "title": "Warranty Claims Triage Agent API",
    "description": "Analyzes incoming warranty claims, dealer repair orders, and TSBs to detect recurring defect patterns, flag known open issues, and draft triage summaries for Quality Engineering.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://warranty-claims-triage-agent-rigjvltcea-uc.a.run.app",
      "description": "Cloud Run Agent Runtime Endpoint"
    }
  ],
  "paths": {
    "/api/v1/triage": {
      "post": {
        "operationId": "triageWarrantyClaims",
        "summary": "Triage warranty claims, TSBs, and repair orders",
        "description": "Performs defect spike detection, pattern clustering, and severity scoring against NHTSA BigQuery data.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "User triage question"
                  },
                  "model": {
                    "type": "string",
                    "description": "Optional vehicle model filter"
                  },
                  "vin_prefix": {
                    "type": "string",
                    "description": "Optional 8-char VIN prefix"
                  },
                  "component": {
                    "type": "string",
                    "description": "Optional component name"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful triage analysis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "clusters_found": {
                      "type": "integer"
                    },
                    "severity_assessment": {
                      "type": "object"
                    },
                    "tsb_matches": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "actions_taken": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "operationId": "gleanCompatibleChat",
        "summary": "Glean-compatible chat endpoint",
        "description": "Accepts Glean message schema and returns triage analysis as assistant message.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messages"
                ],
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "content": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent reply in Glean message format"
          }
        }
      }
    }
  }
}