# Gemini API Key (for local testing & development)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-2.5-flash)
MODEL_NAME=gemini-2.5-flash

# Google Cloud Deployment & Agent Runtime
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_REGION=us-central1
SERVICE_NAME=warranty-claims-triage-agent

# Pluggable Mode: true = use local in-memory/mock data; false = live APIs
MOCK_DATA_MODE=true

# External Integrations (used when MOCK_DATA_MODE=false)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
QE_TICKETING_API_URL=https://jira.yourcompany.com/rest/api/2/issue
QE_TICKETING_API_TOKEN=your_jira_or_servicenow_token
